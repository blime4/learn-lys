{
  "name": "learn-lys",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Obsidian notes and a curated public learning site",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
