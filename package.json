    "dev": "node scripts/serve.mjs",
    "local": "npm run build && node scripts/local-server.mjs"
  },
  "dependencies": {
    "marked": "18.1.2",
    "sanitize-html": "2.18.1",
    "yaml": "2.9.1"
  }
}
